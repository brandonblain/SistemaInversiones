{
  "name": "portal-inversionistas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm ci && npm --prefix web ci && npm run setup:local",
    "setup:local": "node scripts/setup-local.mjs",
    "start": "npm run web:build && wrangler dev",
    "dev": "wrangler dev",
    "dev:web": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "vitest run",
    "test:web": "npm --prefix web test",
    "test:all": "vitest run && npm --prefix web test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "deploy:staging": "npm run web:build && wrangler deploy --env staging",
    "deploy:production": "npm run web:build && wrangler deploy --env production",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:staging": "wrangler d1 migrations apply DB --env staging --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "seed:sql": "node scripts/seed-staging.mjs",
    "admin:sql": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@types/better-sqlite3": "^9.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "better-sqlite3": "^13.0.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7",
    "wrangler": "^4.151.1"
  }
}
