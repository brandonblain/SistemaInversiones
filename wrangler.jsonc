{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portal-inversionistas",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend (React/Vite) compilado como archivos estáticos. El Worker atiende TODAS las peticiones:
  // separa el sitio público del portal por dominio (src/worker/middleware/sites.ts), aplica cabeceras
  // de seguridad y entrega los archivos con env.ASSETS (rutas desconocidas → index.html de la SPA).
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portal-inversionistas-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "portal-inversionistas-docs-private" }],

  // 06:00 UTC = 00:00 en Ciudad de México (UTC-6). Solo genera vistas previas y avisos.
  "triggers": { "crons": ["0 6 * * *"] },

  // Desarrollo local (wrangler dev). Las variables NO se heredan entre entornos: cada entorno las define todas.
  "vars": {
    "ENVIRONMENT": "development",
    "APP_BASE_URL": "http://localhost:8787",
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "DEFAULT_CURRENCY": "MXN",
    "EMAIL_FROM": "avisos@portal-inversionistas.local",
    "EMAIL_PROVIDER": "log",
    "REQUIRE_ADMIN_MFA": "false",
    "FINANCIAL_RULES_APPROVED": "false"
  },

  "env": {
    "staging": {
      "name": "portal-inversionistas-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_BASE_URL": "https://staging.portal-inversionistas.example",
        "ALLOWED_ORIGINS": "",
        "DEFAULT_CURRENCY": "MXN",
        "EMAIL_FROM": "avisos-staging@portal-inversionistas.example",
        "EMAIL_PROVIDER": "log",
        "REQUIRE_ADMIN_MFA": "true",
        "FINANCIAL_RULES_APPROVED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portal-inversionistas-db-staging",
          "database_id": "REEMPLAZAR-con-id-de-staging",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "portal-inversionistas-docs-staging" }],
      "triggers": { "crons": ["0 6 * * *"] }
    },
    "production": {
      "name": "portal-inversionistas-production",
      // Solo los dominios propios (Settings › Domains & Routes): pimexfortexcapital.com.mx y clientes.…
      // Sin *.workers.dev ni URLs de vista previa: una sola dirección por sitio (cookies, CSRF y enlaces).
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENVIRONMENT": "production",
        // Portal de clientes: login, paneles, API y enlaces de recuperación de contraseña.
        "APP_BASE_URL": "https://clientes.pimexfortexcapital.com.mx",
        "PUBLIC_HOST": "pimexfortexcapital.com.mx",
        "PORTAL_HOST": "clientes.pimexfortexcapital.com.mx",
        "ALLOWED_ORIGINS": "",
        "DEFAULT_CURRENCY": "MXN",
        // Debe pertenecer a un dominio verificado en Resend.
        "EMAIL_FROM": "avisos@pimexfortexcapital.com.mx",
        "EMAIL_PROVIDER": "resend",
        "REQUIRE_ADMIN_MFA": "true",
        // Cambiar a "true" SOLO con la aprobación escrita de convenciones (docs/01, decisiones 1-4).
        "FINANCIAL_RULES_APPROVED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "portal-inversionistas-db-prod",
          "database_id": "06615f8f-6e23-4739-a073-b0e0115565e1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "DOCS_BUCKET", "bucket_name": "portal-inversionistas-docs-prod" }],
      "triggers": { "crons": ["0 6 * * *"] }
    }
  }
}
